# Local reverse proxy on the same machine
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=https://scm.perdues.me
LIBRARY_DIR=data/shared-library

# Abuse limits for the public shared library (the values below are the defaults).
# LIBRARY_MAX_FILES=500
# LIBRARY_MAX_BYTES=1073741824
# MAX_CONCURRENT_UPLOADS=4

# For a container or connections from another machine, use HOST=0.0.0.0.
# For plain HTTP LAN testing, PUBLIC_ORIGIN must match http://your-server-ip:4173.
